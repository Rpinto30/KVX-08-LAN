digraph Grafico2 {
    rankdir=LR;
    nodesep=0.7; 
    ranksep=0.7; 

    labelloc="t";
    label="Diagrama Validacion de Cadenas\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q1 [shape=circle, label="q1"];
    q2 [shape=circle, label="q2"];
    q3 [shape=circle, label="q3"];
    q4 [shape=circle, label="q4"];
    q5 [shape=circle, label="q5"];
    q6 [shape=circle, label="q6"];

    leyenda [shape=none, margin=0, label=<
        <table border="0" cellborder="0" cellspacing="2" align="left">
            <tr><td align="left">q0 = vacio</td></tr>
            <tr><td align="left">q1 = inicia cadena {</td></tr>
            <tr><td align="left">q2 = espera caracter num hex</td></tr>
            <tr><td align="left">q3 = espera una coma</td></tr>
            <tr><td align="left">q4 = cierra cadena }</td></tr>
            <tr><td align="left">q5 = espera entero ~</td></tr>
            <tr><td align="left">q6 = espera caracter num dec</td></tr>
        </table>
    >, fontsize=11];

    { rank=same; q0; leyenda; }
    { rank=same; q1; }
    { rank=same; q5; }
    { rank=same; q2; }
    { rank=same; q3; q6; }
    { rank=same; q4; }

    q0 -> leyenda [style=invis, weight=10];
    inicio -> q0 [color="red", penwidth=2];

    q0 -> q1 [color="black", penwidth=2, weight=10];
    q1 -> q2 [label=" {", color="black", weight=10];
    q2 -> q3 [color="black", weight=10];
    q3 -> q4 [style=invis, weight=10]; 

    q1 -> q5 [color="black"];
    q5 -> q6 [color="black"];
    q2 -> q5 [label=" ~", color="black", constraint=false];

    q3 -> q6 [dir=back, color="black", weight=5];
    q3 -> q2 [label=" \",\"", color="black", constraint=false];

    q2 -> q2 [label="0-9, A-F, x", color="black", fontcolor="black"];
    q6 -> q6 [label="0-9", color="black", fontcolor="black"];
    q2 -> q4 [label=" }", color="black", constraint=false];
    q6 -> q4 [color="black", constraint=false];
    q4:n -> q0:n [color="black", penwidth=1.5, constraint=false];

    q3 [style="filled", fillcolor="#b3ffcc", color="#00C853", penwidth=3.5];
}