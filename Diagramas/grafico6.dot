digraph Grafico6 {
    rankdir=LR;
    labelloc="t";
    label="Diagrama Validacion de Cadenas Condicionales\n\n";
    fontsize=16;
    fontname="Arial Bold";
    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q13 [shape=circle, label="q13"];
    q14 [shape=circle, label="q14"];
    boolean [shape=ellipse, label="boolean"];
    q15 [shape=circle, label="q15"];
    cadena [shape=ellipse, label="cadena"];
    q16 [shape=circle, label="q16"];

    leyenda [shape=none, margin=0, label=<
        <table border="0" cellborder="0" cellspacing="2" align="left">
            <tr><td align="left">q13 = Espera inicio &quot;%&quot;</td></tr>
            <tr><td align="left">q14 = Espera &quot;(&quot;</td></tr>
            <tr><td align="left">boolean = True/false (Condiciones)</td></tr>
            <tr><td align="left">q15 = Espera &quot;)&quot;</td></tr>
            <tr><td align="left">Cadena = Ingreso de una o mas cadenas</td></tr>
            <tr><td align="left">q16 = Espera Fin &quot;#%&quot;</td></tr>
        </table>
    >, fontsize=11];

    { rank=same; q0; leyenda; }       // Mantiene la leyenda debajo de q0
    { rank=same; q13; q16; }          // Mantiene a q16 debajo de q13
    { rank=same; boolean; cadena; }   // Mantiene a cadena debajo de boolean

    // Guías invisibles para estructurar las filas hacia abajo
    q0 -> leyenda [style=invis, weight=10];
    q13 -> q16 [style=invis, weight=10];
    boolean -> cadena [style=invis, weight=10];

    inicio -> q0 [color="red", penwidth=2];
    q0 -> q13 [color="#00C853", penwidth=2, weight=10];
    q13 -> q14 [label=" %", color="#00C853", weight=10];
    q14 -> boolean [label=" (", color="#00C853", weight=10];
    boolean -> q15 [label=" )", color="#00C853", weight=10];

    boolean:n -> boolean:n [color="#00C853"];
    cadena:s -> cadena:s [color="#00C853"];
    q15 -> cadena [color="#00C853", constraint=false];
    cadena -> q16 [color="#00C853", constraint=false];
    q16 -> q0 [label=" #%", color="#00C853", constraint=false];
}