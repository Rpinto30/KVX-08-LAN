digraph Grafico7 {
    rankdir=LR;
    labelloc="t";
    label="Diagrama Validacion de Cadenas en Bucles\n\n";
    fontsize=16;
    fontname="Arial Bold";
    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q17 [shape=circle, label="q17"];
    q14 [shape=circle, label="q14"];
    boolean [shape=ellipse, label="boolean"];
    q15 [shape=circle, label="q15"];
    q18 [shape=circle, label="q18"];
    cadena [shape=ellipse, label="cadena"];



    { rank=same; q17; q18; }     
    { rank=same; boolean; cadena; } 

    q17 -> q18 [style=invis, weight=10];
    boolean -> cadena [style=invis, weight=10];

    inicio -> q0 [color="red", penwidth=2];

    q0 -> q17 [color="black", penwidth=2, weight=10];
    q17 -> q14 [label=" @", color="black", weight=10];
    q14 -> boolean [label=" (", color="black", weight=10];
    boolean -> q15 [label=" )", color="black", weight=10];

    boolean:n -> boolean:n [color="black"];
    cadena:s -> cadena:s [color="black"];

    q15 -> cadena [color="black", constraint=false];
    cadena -> q18 [color="black", constraint=false];
    q18 -> q0 [label=" #@", color="black", constraint=false];
}