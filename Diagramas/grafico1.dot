digraph Grafico1 {
    rankdir=LR;
    
    labelloc="t";
    label="Diagrama Validacion de Asignacion de Variables\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q24 [shape=circle, label="q24"];
    cadena1 [shape=ellipse, label="cadena"];
    cadena2 [shape=ellipse, label="cadena"];
    q8 [shape=circle, label="q8"];

    { rank=same; cadena1; q8; }

    cadena1 -> q8 [style=invis];

    inicio -> q0 [color="red", penwidth=2];
    q0 -> q24 [color="black", penwidth=2];
    q24 -> cadena1 [label=" *", color="black"];
    cadena1 -> cadena2 [label=" =", color="black"];

    cadena2 -> cadena2 [label="0-9, A-F", color="black", fontcolor="black"];

    cadena2 -> q8 [label=" ;", color="black"];
    q8 -> q0 [color="black"];
}