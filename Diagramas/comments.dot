digraph Grafico5 {
    rankdir=LR;
    nodesep=0.7; // Separación vertical
    ranksep=0.8; // Separación horizontal
    labelloc="t";
    label="Diagrama Validacion de Comentarios\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];
    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q19 [shape=circle, label="q19"];
    q20 [shape=circle, label="q20"];
    q21 [shape=circle, label="q21"];

    leyenda [shape=none, margin=0, label=<
        <table border="0" cellborder="0" cellspacing="2" align="left">
            <tr><td align="left">q19 = Espera &lt;!--</td></tr>
            <tr><td align="left">q20 = Espera un caracter</td></tr>
            <tr><td align="left">Numérico o alfabetico</td></tr>
            <tr><td align="left">q21 = Espera --&gt;</td></tr>
        </table>
    >, fontsize=11];

    { rank=same; q0; leyenda; }
    { rank=same; q19; q21; } // Coloca a q21 exactamente debajo de q19
    { rank=same; q20; }

    q0 -> leyenda [style=invis, weight=10];
    q19 -> q21 [style=invis, weight=10];
    inicio -> q0 [color="red", penwidth=2];

    q0 -> q19 [color="#00C853", penwidth=2, weight=10];
    q19 -> q20 [label=" < ! --", color="#00C853", penwidth=2, weight=10];
    q20 -> q20 [label=" A - Z, 0 -9", color="#00C853", fontcolor="black"];
    q20 -> q21 [label=" -->", color="#00C853", constraint=false];
    q21 -> q0 [color="#00C853", constraint=false];
}