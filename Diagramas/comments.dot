digraph Grafico5 {
    rankdir=LR;
    nodesep=0.7; 
    ranksep=0.8; 
    labelloc="t";
    label="Diagrama Validacion de Comentarios\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];
    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q19 [shape=circle, label="q19"];
    q20 [shape=circle, label="q20"];
    q21 [shape=circle, label="q21"];

    { rank=same; q19; q21; }
    { rank=same; q20; }

    q19 -> q21 [style=invis, weight=10];
    inicio -> q0 [color="red", penwidth=2];

    q0 -> q19 [color="black", penwidth=2, weight=10];
    q19 -> q20 [label=" < ! --", color="black", penwidth=2, weight=10];
    q20 -> q20 [label=" A - Z, 0 -9", color="black", fontcolor="black"];
    q20 -> q21 [label=" -->", color="black", constraint=false];
    q21 -> q0 [color="black", constraint=false];
}