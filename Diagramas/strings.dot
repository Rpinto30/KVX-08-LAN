digraph Grafico2 {
    rankdir=LR;
    nodesep=0.6;
    ranksep=0.9;
    splines=true;
    concentrate=false;

    labelloc="t";
    label="Diagrama Validacion de Cadenas\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5, shape=circle];
    edge [fontname="Arial", fontsize=11, penwidth=1.5, color="black"];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q1 [label="q1"];
    q2 [label="q2"];
    q3 [label="q3"];
    q4 [label="q4"];
    q5 [label="q5"];
    q6 [label="q6"];

    { rank=same; q3; q5; q4; }
    q3 -> q5 [style=invis];
    q5 -> q4 [style=invis];

    inicio -> q0 [penwidth=2, color="red"];
    q0 -> q1 [weight=100];
    q1 -> q2 [label=" {", weight=100];
    q2 -> q2 [label="0-9, A-F, x"];
    q2 -> q3;
    q3 -> q2 [label=" \",\""];
    q2 -> q5 [label=" ~", weight=100];
    q5 -> q6 [weight=100];
    q6 -> q6 [label="0-9"];
    q6 -> q3;
    q2 -> q4 [label=" }"];
    q6 -> q4;
    q4 -> q0;
}
