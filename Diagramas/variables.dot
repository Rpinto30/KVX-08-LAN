digraph Grafico3 {
    rankdir=LR;
    nodesep=0.6;
    ranksep=0.7;

    labelloc="t";
    label="Diagrama Validacion de Variables\n\n";
    fontsize=16;
    fontname="Arial Bold";

    node [fontname="Arial", fontsize=12, penwidth=1.5];
    edge [fontname="Arial", fontsize=11, penwidth=1.5];

    inicio [shape=none, label="", width=0, height=0];
    q0 [shape=doublecircle, label="q0"];
    q7 [shape=circle, label="q7"];
    cadena [shape=ellipse, label="cadena"];
    q25 [shape=ellipse, label="q25"];
    q8 [shape=circle, label="q8"];

    { rank=same; cadena; q8; }
    cadena -> q8 [style=invis];
    inicio -> q0 [color="red", penwidth=2];

    q0 -> q7 [color="black", penwidth=2];
    q7 -> cadena [label=" $", color="black"];
    cadena -> q25 [label=" =", color="black"];
    q25 -> q25 [label="0-9, cadena,\n+,-,/,*", color="black", fontcolor="black"];
    q25 -> q8 [label="  ;", fontsize=14, fontname="Arial Bold", color="black", constraint=false];
    q8 -> q0 [color="black", constraint=false];
}